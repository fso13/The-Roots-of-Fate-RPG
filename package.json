    "pdf:hranitel": "npm run build && node scripts/build-pdf.mjs --audience keeper",
    "book:md": "node scripts/build-book-md.mjs --audience all",
    "book:igrok": "node scripts/build-book-md.mjs --audience player",
    "book:hranitel": "node scripts/build-book-md.mjs --audience keeper",
    "book:homebrewery": "node scripts/build-book-homebrewery.mjs --audience all",
    "book:homebrewery:igrok": "node scripts/build-book-homebrewery.mjs --audience player",
    "book:homebrewery:hranitel": "node scripts/build-book-homebrewery.mjs --audience keeper"
  },
  "dependencies": {
    "marked": "^15.0.4"
  },
  "devDependencies": {
    "playwright": "^1.52.0",
    "sharp": "^0.34.5"
  }
